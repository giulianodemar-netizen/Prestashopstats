{
  "name": "giulianodemar/prestashopstats",
  "description": "Comprehensive statistics module for PrestaShop providing detailed analytics about sales, customers, products, geolocation, and traffic",
  "type": "prestashop-module",
  "keywords": [
    "prestashop",
    "statistics",
    "analytics",
    "sales",
    "customers",
    "ecommerce",
    "reporting"
  ],
  "homepage": "https://github.com/giulianodemar-netizen/Prestashopstats",
  "license": "MIT",
  "authors": [
    {
      "name": "Giuliano De Mar",
      "email": "giuliano@example.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/giulianodemar-netizen/Prestashopstats/issues",
    "source": "https://github.com/giulianodemar-netizen/Prestashopstats"
  },
  "require": {
    "php": ">=7.1.0"
  },
  "require-dev": {
    "prestashop/php-dev-tools": "^3.0"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "archive": {
    "exclude": [
      ".git",
      ".gitignore",
      ".github",
      "tests",
      "node_modules"
    ]
  }
}
